# Daybook environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# SQLite file path (persistent local pilot). For hosted Postgres, see README.
DB_PATH=./data/daybook.db

# --- Local AI (Ollama) — the ONLY inference provider ---
# Daybook has no paid AI integration and will never fall back to one.
# Install Ollama from https://ollama.com, then:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# NOTE: there is deliberately no OPENAI_API_KEY / ANTHROPIC_API_KEY setting.
# Adding one has no effect — the assistant only uses the local model above.
