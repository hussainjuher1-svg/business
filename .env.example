# Daybook environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# SQLite file path (persistent local pilot). For hosted Postgres, see README.
DB_PATH=./data/daybook.db

# --- Optional: run behind exactly one reverse proxy ---
# Only set this if a proxy you control is in front of Daybook (the hosting
# platform or nginx). It makes Express trust the last hop of X-Forwarded-For so
# the login rate limiter sees real client addresses. Leave it unset locally —
# otherwise a client can forge the header and bypass the per-IP limit.
# TRUST_PROXY=1

# --- Local AI (Ollama) — the ONLY inference provider ---
# Daybook has no paid AI integration and will never fall back to one.
# Install Ollama from https://ollama.com, then:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# NOTE: there is deliberately no OPENAI_API_KEY / ANTHROPIC_API_KEY setting.
# Adding one has no effect — the assistant only uses the local model above.

# --- Local only (Windows 11) ---
# Daybook is designed to run on the same machine as Ollama. The endpoint above
# must stay a loopback address: http://127.0.0.1:11434, http://localhost:11434,
# http://[::1]:11434, or another 127.0.0.0/8 address. Anything else - https, a
# LAN address such as 192.168.x.x, a public IP, 0.0.0.0 or a *.local name - is
# rejected before a connection is opened. Do not point it at a public/hosted
# Ollama, and do not put Ollama behind a tunnel or proxy.

# --- Test/validation knobs (optional) ---
# Current password for a demo account in an already-rotated throwaway database.
# Never needed for a freshly seeded database. Never commit a real password.
# DAYBOOK_DEMO_PASSWORD=

# Where the evaluation runner writes results (default: ./eval-results).
# DAYBOOK_EVAL_DIR=

# --- Login rate limiting (optional tuning; defaults shown) ---
# LOGIN_MAX_PER_EMAIL=5
# LOGIN_MAX_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_IP_LOCKOUT_MINUTES=1
