# Daybook environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# SQLite file path (persistent local pilot). For hosted Postgres, see README.
DB_PATH=./data/daybook.db

# --- AI Assistant (optional) ---
# Without these, Daybook uses its built-in assistant which answers from real
# database records (no external model needed). Set one provider to enable an LLM.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=gpt-4o-mini
