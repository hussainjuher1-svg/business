{
  "name": "daybook",
  "version": "1.0.0",
  "private": true,
  "description": "Daybook \u2014 simple, intelligent business-management platform with a local-only AI assistant",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:migrate": "node server/src/migrate.js",
    "db:seed": "node server/seed.js",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "start": "node server/src/index.js",
    "build": "npm --prefix client run build",
    "test": "NODE_NO_WARNINGS=1 node --test server/test/assistant.test.js server/test/release-blockers.test.js server/test/security.test.js",
    "test:blockers": "NODE_NO_WARNINGS=1 node --test server/test/release-blockers.test.js",
    "test:security": "NODE_NO_WARNINGS=1 node --test server/test/security.test.js",
    "seed:hvac": "node server/seed-hvac.js",
    "validate:hvac": "node server/validate-hvac.js",
    "audit:pilot": "node server/audit-pilot.js",
    "verify:persistence": "bash server/verify-persistence.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
